# ============================================
# Aspen Multi-Tenant API - Environment Variables
# ============================================

# ============ Server Config ============
# 服务端口
PORT=3000

# Node/Bun 运行环境
NODE_ENV=development

# ============ Database Config ============
# 主数据库连接 (用于存储租户配置)
DATABASE_URL=postgresql://postgres:password@localhost:5432/aspen_main

# ============ Redis Config ============
# Redis 连接 (用于租户配置缓存、会话)
REDIS_URL=redis://localhost:6379

# ============ Storage Config ============
# S3/OSS 存储配置
S3_REGION=ap-east-1
S3_BUCKET=aspen-multi-tenant
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# CDN 域名
CDN_URL=https://cdn.yourdomain.com

# ============ Multi-Tenant Config ============
# 默认租户 ID
DEFAULT_TENANT=aspen

# 是否允许开发模式创建租户
ALLOW_DEV_CREATION=true

# 租户隔离模式: shared_db | separate_db | separate_schema
TENANT_ISOLATION_MODE=shared_db

# ============ Auth Config ============
# JWT 密钥
JWT_SECRET=your-jwt-secret-change-in-production

# ============ API Keys ============
# 管理员 API 密钥 (用于管理后台)
ADMIN_API_KEY=your_admin_api_key_here

# ============ Payment Config ============
# 支付模式: simulate | sandbox | production
PAYMENT_MODE=simulate

# 小程序 App ID
WX_APP_ID=wx_your_app_id
WX_APP_SECRET=your_app_secret

# ============ Feature Flags ============
# 功能开关
ENABLE_TENANT_CREATION=true
ENABLE_THEME_CUSTOMIZATION=true
ENABLE_WEBHOOKS=false

# ============ Logging ============
# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 是否开启请求日志
REQUEST_LOGGING=true
