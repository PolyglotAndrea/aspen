{
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "ASPEN"
      }
    },
    {
      "path": "pages/menu/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "菜单"
      }
    },
    {
      "path": "pages/booking/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "预约"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "我的"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "ASPEN",
    "navigationBarBackgroundColor": "#000000",
    "backgroundColor": "#000000",
    "backgroundTextStyle": "light"
  },
  "tabBar": {
    "color": "rgba(255, 255, 255, 0.5)",
    "selectedColor": "#ffffff",
    "backgroundColor": "rgba(0, 0, 0, 0.8)",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/icons/home.png",
        "selectedIconPath": "static/icons/home-active.png"
      },
      {
        "pagePath": "pages/menu/index",
        "text": "菜单",
        "iconPath": "static/icons/menu.png",
        "selectedIconPath": "static/icons/menu-active.png"
      },
      {
        "pagePath": "pages/booking/index",
        "text": "预约",
        "iconPath": "static/icons/booking.png",
        "selectedIconPath": "static/icons/booking-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/icons/profile.png",
        "selectedIconPath": "static/icons/profile-active.png"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^as-(.*)": "@/components/As$1/As$1.vue"
    }
  }
}
